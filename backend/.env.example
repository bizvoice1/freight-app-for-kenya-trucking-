PORT=4000
DATABASE_PATH=./behari.sqlite
JWT_SECRET=change-me-in-anything-beyond-local-dev

# Phase 4M — leave both unset for local dev (zero-config, unchanged).
# NODE_ENV=production refuses to start with no JWT_SECRET set (see
# backend/README.md's Hardening section) rather than silently falling back
# to the hardcoded dev secret above.
NODE_ENV=
# Comma-separated allow-list of origins permitted to call this API. Unset
# behaves exactly like no CORS restriction at all (today's default).
ALLOWED_ORIGINS=

# Phase 4K — see docs/4K-DARAJA-SPEC.md Section 10. simulate is the default
# and the only mode this repo's own acceptance tests exercise.
DARAJA_ENV=simulate
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=
DARAJA_PASSKEY=
DARAJA_INITIATOR_NAME=
DARAJA_SECURITY_CREDENTIAL=
DARAJA_CALLBACK_BASE_URL=http://localhost:4000
