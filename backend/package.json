{
  "name": "behari-freight-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Phase 4F — Behari Freight tracking backend. SQLite for development, Postgres-ready via Drizzle ORM (see src/db/client.js).",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:generate": "drizzle-kit generate",
